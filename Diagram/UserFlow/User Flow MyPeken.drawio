  <diagram id="uf_04_admin_panel_rbac_governance" name="04. Panel Admin — Admin CS, Operasional KYC &amp; Super Admin">
    <mxGraphModel dx="2200" dy="1110" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1110" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="U4_XREF_CHAT" value="&lt;b&gt;Handoff Live Chat &amp; Katalog Beranda (Hal. 01)&lt;/b&gt;&lt;br&gt;Balas Pesan Live Chat Pelanggan Real-Time (FR-017)&lt;br&gt;&amp; Sinkronisasi Kategori 2-Level serta Karusel&lt;br&gt;Banner Beranda Maks. 5 Aktif (FR-031, FR-034)" style="rounded=1;arcSize=12;dashed=1;dashPattern=6 3;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#4B5563;fontColor=#1F2937;strokeWidth=1.5;fontSize=10.5;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="56" y="56" width="340" height="94" as="geometry" /></mxCell>
        <mxCell id="U4_START" value="&lt;b&gt;Mulai Sesi Panel Admin (FR-028)&lt;/b&gt;&lt;br&gt;Akses Portal Internal Admin MyPeken&lt;br&gt;(Seeding Backend, Tanpa Daftar Mandiri)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#7F1D1D;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="646" y="65" width="320" height="76" as="geometry" /></mxCell>
        <mxCell id="U4_LOGIN" value="&lt;b&gt;Layar Login Admin + Wajib 2FA (FR-028)&lt;/b&gt;&lt;br&gt;Autentikasi Email + Password + Kode 2FA (TOTP);&lt;br&gt;Dilengkapi Idle Session Timeout 30 Menit" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1214" y="57" width="345" height="92" as="geometry" /></mxCell>
        <mxCell id="U4_END_LOGOUT" value="&lt;b&gt;Logout Admin / Timeout 30m (FR-028)&lt;/b&gt;&lt;br&gt;Akhiri Sesi Berbasis Peran (RBAC) Aman" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#7F1D1D;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1801" y="63" width="330" height="80" as="geometry" /></mxCell>
        <mxCell id="U4_CS_CHAT" value="&lt;b&gt;Panel Live Chat Pelanggan (FR-017 — Admin CS)&lt;/b&gt;&lt;br&gt;Terima Antrean Handover dari AI (FR-003),&lt;br&gt;Baca Riwayat AI, Balas Real-Time &amp; Tandai Selesai" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="56" y="336" width="340" height="94" as="geometry" /></mxCell>
        <mxCell id="U4_CS_DISPUTE" value="&lt;b&gt;Panel Resolusi Konflik &amp; Retur (FR-010 — Admin CS)&lt;/b&gt;&lt;br&gt;Tinjau Eskalasi Mediasi 1x24j, Gagal Kirim &amp;&lt;br&gt;Bantahan Retur; Periksa Bukti Unboxing, Polis&lt;br&gt;Asuransi (FR-012), Chat (FR-036) &amp; Lacak Resi" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="634" y="334" width="345" height="98" as="geometry" /></mxCell>
        <mxCell id="U4_DEC_RBAC" value="&lt;b&gt;Otorisasi Peran RBAC?&lt;/b&gt;&lt;br&gt;(1) Admin CS | (2) Admin Ops&lt;br&gt;| (3) Super Admin (FR-028)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;strokeWidth=1.6;fontSize=10.5;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1248" y="319" width="276" height="128" as="geometry" /></mxCell>
        <mxCell id="U4_SUP_HOLD" value="&lt;b&gt;Panel Tarif, Monitor &amp; Hold Saldo (FR-009, FR-019)&lt;/b&gt;&lt;br&gt;Super Admin: (1) Atur Biaya Layanan Flat, Admin&lt;br&gt;PPOB &amp; Komisi Kategori (Min. 1%), (2) Monitor&lt;br&gt;Penarikan (Read-Only) &amp; Daftar Tunggakan Toko" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1794" y="334" width="345" height="98" as="geometry" /></mxCell>
        <mxCell id="U4_EXT_GW" value="&lt;b&gt;Touchpoint Gateway (Notifikasi &amp; Webhook PG)&lt;/b&gt;&lt;br&gt;Gateway OTP &amp; Notifikasi (WA Putusan KYC/Sengketa)&lt;br&gt;Payment Gateway (Webhook Status Disbursement&lt;br&gt;Penarikan &amp; Rekonsiliasi Rekening Escrow)" style="rounded=1;arcSize=12;dashed=1;dashPattern=6 3;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0F766E;fontColor=#134E4A;strokeWidth=1.5;fontSize=10.5;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="56" y="626" width="340" height="94" as="geometry" /></mxCell>
        <mxCell id="U4_ACT_DISPUTE" value="&lt;b&gt;Eksekusi 3 Putusan Sengketa + Alasan (FR-010)&lt;/b&gt;&lt;br&gt;(1) Full Refund (Salah Penjual / Bukan Salah Penjual&lt;br&gt;/ Salah Kurir Berasuransi vs Plafon) | (2) Teruskan&lt;br&gt;ke Penjual | (3) Partial Refund Item / Trigger Retur" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#047857;fontColor=#064E3B;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="632" y="624" width="348" height="98" as="geometry" /></mxCell>
        <mxCell id="U4_OPS_MOD" value="&lt;b&gt;Panel KYC, Moderasi &amp; Kategori (FR-018, 027, 034)&lt;/b&gt;&lt;br&gt;Admin Ops/KYC: (1) Verifikasi Toko Baru/KYC,&lt;br&gt;(2) Moderasi Master Data &amp; Antrean Report Abuse&lt;br&gt;(FR-040), (3) Kategori 2-Level &amp; Banner Maks. 5" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1214" y="624" width="345" height="98" as="geometry" /></mxCell>
        <mxCell id="U4_ACT_SUP" value="&lt;b&gt;Simpan Tarif, Tahan Saldo &amp; Rekening (FR-009..035)&lt;/b&gt;&lt;br&gt;Update Rate Snapshot Komisi/Biaya; Tahan Saldo&lt;br&gt;Toko (Maks. 14 Hari) / Lepas Saldo; &amp; Verifikasi&lt;br&gt;Manual Bukti Buku Tabungan Rekening Penjual" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#047857;fontColor=#064E3B;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1794" y="624" width="345" height="98" as="geometry" /></mxCell>
        <mxCell id="U4_XREF_USERS" value="&lt;b&gt;Sinkronisasi Putusan ke Halaman 02 &amp; 03&lt;/b&gt;&lt;br&gt;Hal. 02: Cairkan Dana Refund Pembeli &amp; Notif Abuse&lt;br&gt;Hal. 03: Aktivasi Toko KYC, Potong/Catat Tunggakan,&lt;br&gt;Status Suspend/Hold/Blacklist &amp; Update Rekening" style="rounded=1;arcSize=12;dashed=1;dashPattern=6 3;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#4B5563;fontColor=#1F2937;strokeWidth=1.5;fontSize=10.5;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="56" y="915" width="340" height="96" as="geometry" /></mxCell>
        <mxCell id="U4_AUDIT" value="&lt;b&gt;Pencatatan &amp; Tabel Immutable Audit Log (FR-029)&lt;/b&gt;&lt;br&gt;Rekam Permanen (Identitas, Peran, Waktu, Aksi,&lt;br&gt;Alasan Wajib, Nilai Sebelum/Sesudah) atas Seluruh&lt;br&gt;Aksi Sensitif &amp; Ekspor; Read-Only Super Admin" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#047857;fontColor=#064E3B;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="634" y="914" width="345" height="98" as="geometry" /></mxCell>
        <mxCell id="U4_ACT_MOD_KYC" value="&lt;b&gt;Putusan KYC, Moderasi &amp; Blacklist (FR-018, FR-027)&lt;/b&gt;&lt;br&gt;Setujui/Tolak KYC Toko; Hapus Produk, Sembunyikan&lt;br&gt;Ulasan Spam (Hitung Ulang Rating), Suspend Toko/&lt;br&gt;Akun (Hold &amp; Batal Order), Blacklist NIK (&gt;30 Hari)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#047857;fontColor=#064E3B;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1214" y="914" width="345" height="98" as="geometry" /></mxCell>
        <mxCell id="U4_SUP_FIN" value="&lt;b&gt;Dashboard Analitik, Keuangan &amp; Rekonsiliasi (FR-041)&lt;/b&gt;&lt;br&gt;Khusus Super Admin: GMV, Pendapatan Bersih (Komisi&lt;br&gt;+ Fee + PPOB - Subsidi Transfer), Liabilitas Escrow/&lt;br&gt;Saldo/Piutang, Top 5 UMKM &amp; Ekspor CSV/XLSX/PDF" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1792" y="914" width="348" height="98" as="geometry" /></mxCell>
        <mxCell id="e_1_U4_START_U4_LOGIN" value="Buka Portal&lt;br&gt;Internal Admin" style="edgeStyle=none;rounded=1;arcSize=8;jumpStyle=arc;jumpSize=7;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=classic;endFill=1;startArrow=none;strokeColor=#1D4ED8;strokeWidth=1.35;fontSize=9.5;fontFamily=Helvetica;fontColor=#1D4ED8;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="U4_START" target="U4_LOGIN"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_2_U4_LOGIN_U4_END_LOGOUT" value="Klik Logout /&lt;br&gt;Idle Timeout 30m" style="edgeStyle=none;rounded=1;arcSize=8;jumpStyle=arc;jumpSize=7;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=classic;endFill=1;startArrow=none;strokeColor=#B91C1C;strokeWidth=1.35;fontSize=9.5;fontFamily=Helvetica;fontColor=#B91C1C;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="U4_LOGIN" target="U4_END_LOGOUT"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
