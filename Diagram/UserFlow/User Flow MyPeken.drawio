        <mxCell id="U3_START" value="&lt;b&gt;Masuk Mode Penjual UMKM&lt;/b&gt;&lt;br&gt;Klik &quot;Buka Toko Gratis&quot; atau&lt;br&gt;&quot;Dashboard Toko&quot; dari Profil (FR-001)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#7F1D1D;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="79" y="120" width="315" height="76" as="geometry" /></mxCell>
        <mxCell id="U3_DEC_KYC" value="&lt;b&gt;Status KYC &amp; Toko?&lt;/b&gt;&lt;br&gt;Cek Blacklist NIK/Rekening,&lt;br&gt;GPS Sarbagita &amp; Putusan KYC" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;strokeWidth=1.6;fontSize=10.5;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="678" y="94" width="276" height="128" as="geometry" /></mxCell>
        <mxCell id="U3_KYC_FORM" value="&lt;b&gt;Layar Pendaftaran Toko &amp; KYC (FR-004, INV-01..03)&lt;/b&gt;&lt;br&gt;Input Nama/Logo Unik, Foto KTP + Selfie KTP, NIK&lt;br&gt;&amp; Rekening (Nama = KTP; Cek Blacklist Tunggakan),&lt;br&gt;Pin GPS Wajib Sarbagita &amp; Pilih Min. 1 Kurir Awal" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1224" y="109" width="345" height="98" as="geometry" /></mxCell>
        <mxCell id="U3_EXT_MAPS_LOG" value="&lt;b&gt;Touchpoint Maps API &amp; API Logistik&lt;/b&gt;&lt;br&gt;Maps API (Validasi Koordinat GPS Toko Sarbagita)&lt;br&gt;API Logistik (Auto-Booking Resi Reguler &amp;&lt;br&gt;Panggil Driver Instan / Same-Day)" style="rounded=1;arcSize=12;dashed=1;dashPattern=6 3;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0F766E;fontColor=#134E4A;strokeWidth=1.5;fontSize=10.5;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1804" y="111" width="345" height="94" as="geometry" /></mxCell>
        <mxCell id="U3_SETTINGS" value="&lt;b&gt;Layar Profil, Jam, Libur &amp; Kurir Toko (FR-016, FR-037)&lt;/b&gt;&lt;br&gt;Update Profil &amp; Pin GPS Sarbagita, Jadwal Buka,&lt;br&gt;Toggle Libur (Timer Order Aktif Tetap Berjalan),&lt;br&gt;&amp; Toggle Kurir Instan/Same-Day/Reguler (Min. 1)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="56" y="389" width="360" height="98" as="geometry" /></mxCell>
        <mxCell id="U3_DASH" value="&lt;b&gt;Layar Dashboard Toko, Statistik &amp; Notif (FR-006..007)&lt;/b&gt;&lt;br&gt;Grafik Pendapatan Harian/Mingguan/Bulanan, Total&lt;br&gt;Selesai/Batal, Top 5 Produk Terlaris, Notifikasi&lt;br&gt;In-App &amp; WA (&quot;Pesanan Baru&quot;) + Chat Pembeli" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="640" y="389" width="352" height="98" as="geometry" /></mxCell>
        <mxCell id="U3_ORDERS" value="&lt;b&gt;Layar Daftar Pesanan Masuk &amp; Label PDF (FR-014..038)&lt;/b&gt;&lt;br&gt;Kelola Pesanan &quot;Dibayar&quot; &amp; &quot;Diproses&quot; (&quot;Mencari&lt;br&gt;Driver&quot;), Cetak Label PDF, Tanggapi Batal Pembeli,&lt;br&gt;Balas Ulasan Publik (1x) &amp; Lapor Ulasan Spam" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1222" y="389" width="348" height="98" as="geometry" /></mxCell>
        <mxCell id="U3_ACT_SHIP" value="&lt;b&gt;Terbitkan Resi Otomatis / Panggil Driver (FR-014)&lt;/b&gt;&lt;br&gt;Auto-Booking Resi Reguler atau Panggil Driver&lt;br&gt;(Timer Cari Driver: 3j Instan / 6j Same-Day) -&gt;&lt;br&gt;Status &quot;Dikirim&quot; (Salurkan Ongkir &amp; Asuransi)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#047857;fontColor=#064E3B;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1804" y="389" width="345" height="98" as="geometry" /></mxCell>
        <mxCell id="U3_CATALOG" value="&lt;b&gt;Layar Manajemen Produk, Varian &amp; Diskon (FR-005)&lt;/b&gt;&lt;br&gt;CRUD Produk, Berat &amp; Dimensi (PxLxT), Varian 2-Level,&lt;br&gt;Maks. 10 Etalase, Diskon Harga Coret (1%–90% Tanpa&lt;br&gt;Voucher), serta Soft Delete / Hide Produk (INV-05)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="60" y="679" width="352" height="98" as="geometry" /></mxCell>
        <mxCell id="U3_WALLET" value="&lt;b&gt;Layar Saldo Toko &amp; Riwayat Mutasi (FR-015, FR-019)&lt;/b&gt;&lt;br&gt;Total Pendapatan, Saldo Ditahan Admin (FR-019),&lt;br&gt;Saldo Tertunggak, Saldo Bersih Tersedia &amp; Mutasi&lt;br&gt;(Escrow, Komisi, Withdrawal, Beban Ongkir/Retur)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="644" y="679" width="345" height="98" as="geometry" /></mxCell>
        <mxCell id="U3_MEDIATION" value="&lt;b&gt;Layar Mediasi Komplain &amp; Retur (FR-010, FR-020)&lt;/b&gt;&lt;br&gt;Tanggapi Mediasi 1x24 Jam (Setuju Full/Partial&lt;br&gt;Refund atau Tolak); Saat Retur &quot;Terkirim&quot; (2x24j):&lt;br&gt;Konfirmasi Terima Retur atau Bantah + Unboxing" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1224" y="679" width="345" height="98" as="geometry" /></mxCell>
        <mxCell id="U3_DEC_SLA" value="&lt;b&gt;Proses &amp; Kirim &lt;= SLA?&lt;/b&gt;&lt;br&gt;Reguler 1x24j/2x24j, Same-Day&lt;br&gt;3j/4j, Instan 2j/2j &amp; Driver" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;strokeWidth=1.6;fontSize=10.5;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1838" y="664" width="276" height="128" as="geometry" /></mxCell>
        <mxCell id="U3_ACT_WD" value="&lt;b&gt;Penarikan Saldo Toko Otomatis (FR-015)&lt;/b&gt;&lt;br&gt;Ke Rekening Terverifikasi (Min. Rp50.000, Biaya&lt;br&gt;Ditanggung Penjual); Verifikasi PIN Saldo 6 Digit +&lt;br&gt;OTP Multi-Saluran, Lock Pending &amp; Disbursement PG" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#047857;fontColor=#064E3B;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="66" y="969" width="340" height="98" as="geometry" /></mxCell>
        <mxCell id="U3_DEC_ARREARS" value="&lt;b&gt;Status Tunggakan Toko?&lt;/b&gt;&lt;br&gt;Tunggakan &gt; Rp0, &gt;Rp250rb&lt;br&gt;atau &gt;14 Hari (INV-07)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;strokeWidth=1.6;fontSize=10.5;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="678" y="954" width="276" height="128" as="geometry" /></mxCell>
        <mxCell id="U3_ACT_ARREARS" value="&lt;b&gt;Pelunasan Tunggakan &amp; Auto-Suspend (FR-015, INV-07)&lt;/b&gt;&lt;br&gt;Blokir Tarik Saldo; Potong Penjualan Berikutnya atau&lt;br&gt;Klik &quot;Bayar Tunggakan&quot; (VA/QRIS/EW); &gt;Rp250rb /&lt;br&gt;&gt;14 Hari (Notif H-3, H-1) -&gt; Auto-Suspend Toko" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#047857;fontColor=#064E3B;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1222" y="969" width="348" height="98" as="geometry" /></mxCell>
        <mxCell id="U3_END_AUTOCANCEL" value="&lt;b&gt;Pesanan Batal &amp; Refund Pembeli (FR-014, FR-021)&lt;/b&gt;&lt;br&gt;Tolak Pesanan, Lewat SLA Terima/Kirim, atau&lt;br&gt;Gagal Cari Driver -&gt; 100% ke Saldo Bebas Tarik" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#7F1D1D;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1798" y="974" width="356" height="88" as="geometry" /></mxCell>
        <mxCell id="U3_EXT_PG_OTP" value="&lt;b&gt;Touchpoint Payment Gateway &amp; Gateway OTP&lt;/b&gt;&lt;br&gt;Payment Gateway (Disbursement Tarik Saldo,&lt;br&gt;Bank Account Inquiry &amp; Tagihan Bayar Tunggakan)&lt;br&gt;Gateway OTP &amp; Notifikasi (WA / SMS / Email)" style="rounded=1;arcSize=12;dashed=1;dashPattern=6 3;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0F766E;fontColor=#134E4A;strokeWidth=1.5;fontSize=10.5;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="66" y="1261" width="340" height="94" as="geometry" /></mxCell>
        <mxCell id="U3_BANK_CHG" value="&lt;b&gt;Layar Ubah Rekening Bank Mandiri (FR-035)&lt;/b&gt;&lt;br&gt;Blokir jika Ada Penarikan Pending / Saldo Ditahan;&lt;br&gt;Cek Nama Pemilik = Nama KTP via Bank Inquiry API -&gt;&lt;br&gt;Cocok: PIN + OTP | Beda Wajar: Fallback Super Admin" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="644" y="1259" width="345" height="98" as="geometry" /></mxCell>
        <mxCell id="U3_XREF_ADMIN" value="&lt;b&gt;Handoff ke Halaman 04 (Panel Admin) &amp; Hal. 02&lt;/b&gt;&lt;br&gt;Hal. 04: Tinjauan KYC (FR-027), Arbitrase Sengketa&lt;br&gt;Retur (FR-010), Blacklist &gt;30 Hari (FR-018) &amp;&lt;br&gt;Fallback Rekening (FR-035) | Hal. 02: Lacak Pembeli" style="rounded=1;arcSize=12;dashed=1;dashPattern=6 3;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#4B5563;fontColor=#1F2937;strokeWidth=1.5;fontSize=10.5;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1224" y="1259" width="345" height="98" as="geometry" /></mxCell>
