<mxfile host="app.diagrams.net" version="24.7.17" pages="4">
  <diagram id="uf_01_buyer_discovery_checkout" name="01. Pengunjung &amp; Pembeli — Eksplorasi, AI &amp; Checkout">
    <mxGraphModel dx="2330" dy="1380" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2330" pageHeight="1380" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="U1_START" value="&lt;b&gt;Mulai Sesi Pengunjung / Pembeli&lt;/b&gt;&lt;br&gt;Buka Aplikasi Web / Mobile MyPeken&lt;br&gt;(Guest Mode atau Pembeli Login)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#7F1D1D;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="129" y="66" width="315" height="76" as="geometry" /></mxCell>
        <mxCell id="U1_HOME" value="&lt;b&gt;Layar Beranda Utama (FR-031)&lt;/b&gt;&lt;br&gt;Karusel Banner (Maks. 5), Ikon Kategori 2-Level,&lt;br&gt;Shortcut Action Chip PPOB (FR-002)&lt;br&gt;&amp; Katalog Produk Diskon Harga Coret" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="696" y="56" width="340" height="96" as="geometry" /></mxCell>
        <mxCell id="U1_SEARCH" value="&lt;b&gt;Layar Pencarian, Filter &amp; LBS (FR-011, FR-026)&lt;/b&gt;&lt;br&gt;Filter Kategori, Kab/Kota Sarbagita, Harga,&lt;br&gt;Kurir, Rating &amp; Diskon; Urut Terdekat GPS /&lt;br&gt;Alamat Utama atau Relevansi / Terlaris" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1276" y="56" width="340" height="96" as="geometry" /></mxCell>
        <mxCell id="U1_EXT_DISC" value="&lt;b&gt;Touchpoint Gateway (Eksplorasi, AI &amp; OTP)&lt;/b&gt;&lt;br&gt;Maps API (Radius LBS &amp; Geofencing Sarbagita)&lt;br&gt;API AI / LLM (Knowledge Base &amp; Lacak Pesanan)&lt;br&gt;Gateway OTP &amp; Notifikasi (WA / SMS / Email)" style="rounded=1;arcSize=12;dashed=1;dashPattern=6 3;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0F766E;fontColor=#134E4A;strokeWidth=1.5;fontSize=10.5;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1856" y="57" width="340" height="94" as="geometry" /></mxCell>
        <mxCell id="U1_AI_CHAT" value="&lt;b&gt;Layar Bantuan Virtual AI (FR-003)&lt;/b&gt;&lt;br&gt;Tanya Jawab FAQ Bahasa Indonesia &amp;&lt;br&gt;Cek Status Pengiriman Otomatis via&lt;br&gt;Nomor Pesanan Milik Pembeli" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="124" y="337" width="325" height="94" as="geometry" /></mxCell>
        <mxCell id="U1_PDP_STORE" value="&lt;b&gt;Layar Detail Produk &amp; Toko Publik (FR-031)&lt;/b&gt;&lt;br&gt;Galeri, Varian 2-Level, Berat/Dimensi, Etalase,&lt;br&gt;Rating &amp; Ulasan, Info Kurir/Jam/Libur Toko,&lt;br&gt;Tombol Keranjang, Beli, Chat, Wishlist &amp; Lapor" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="694" y="335" width="345" height="98" as="geometry" /></mxCell>
        <mxCell id="U1_DEC_AUTH" value="&lt;b&gt;Sudah Login Pembeli?&lt;/b&gt;&lt;br&gt;Guard Transaksi, Chat,&lt;br&gt;Wishlist &amp; Lapor (FR-001)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;strokeWidth=1.6;fontSize=10.5;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1308" y="320" width="276" height="128" as="geometry" /></mxCell>
        <mxCell id="U1_LOGIN" value="&lt;b&gt;Layar Login &amp; Registrasi (FR-001, INV-01)&lt;/b&gt;&lt;br&gt;3 Metode: (1) No. HP/WA Passwordless OTP,&lt;br&gt;(2) Email &amp; Password (+Tautan No. HP), atau&lt;br&gt;(3) Google OAuth (1 Email &amp; 1 HP = 1 Akun)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1856" y="336" width="340" height="96" as="geometry" /></mxCell>
        <mxCell id="U1_DEC_AI" value="&lt;b&gt;Terjawab oleh AI?&lt;/b&gt;&lt;br&gt;Cakupan FAQ / Lacak&lt;br&gt;(FR-003 / FR-017)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;strokeWidth=1.6;fontSize=10.5;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="148" y="610" width="276" height="128" as="geometry" /></mxCell>
        <mxCell id="U1_ACT_SOCIAL" value="&lt;b&gt;Aksi Sosial, Chat &amp; Report Abuse (FR-036..040)&lt;/b&gt;&lt;br&gt;Simpan Wishlist / Ikuti Toko (FR-039),&lt;br&gt;Chat Langsung Penjual (Teks/Foto/Order, FR-036),&lt;br&gt;atau Lapor Produk/Toko/Ulasan Spam (FR-040)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#047857;fontColor=#064E3B;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="694" y="626" width="345" height="96" as="geometry" /></mxCell>
        <mxCell id="U1_CART" value="&lt;b&gt;Layar Keranjang &amp; Direct Checkout (FR-023)&lt;/b&gt;&lt;br&gt;Kelompok Item per Toko, Ubah Kuantitas/Catatan,&lt;br&gt;atau Tombol &quot;Beli&quot; Langsung dari Detail Produk&lt;br&gt;(Aturan Single-Seller &amp; Anti Self-Purchase)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1274" y="626" width="345" height="96" as="geometry" /></mxCell>
        <mxCell id="U1_ACT_OTP" value="&lt;b&gt;Verifikasi 6 Digit OTP Multi-Saluran (INV-02)&lt;/b&gt;&lt;br&gt;Utama API WhatsApp -&gt; Fallback SMS/Email (60d);&lt;br&gt;Berlaku 5 Menit, Cooldown Resend 60 Detik,&lt;br&gt;Maks. 5x Salah (Blokir 15m) -&gt; Sesi Aktif" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#047857;fontColor=#064E3B;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1856" y="626" width="340" height="96" as="geometry" /></mxCell>
        <mxCell id="U1_XREF_CS" value="&lt;b&gt;Handoff ke Halaman 03 &amp; 04&lt;/b&gt;&lt;br&gt;Hal. 04: Handover Live Chat Admin CS (FR-017)&lt;br&gt;&amp; Antrean Laporan Pelanggaran (FR-018/040)&lt;br&gt;Hal. 03: Pesan Chat Masuk Penjual (FR-036)" style="rounded=1;arcSize=12;dashed=1;dashPattern=6 3;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#4B5563;fontColor=#1F2937;strokeWidth=1.5;fontSize=10.5;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="121" y="917" width="330" height="94" as="geometry" /></mxCell>
        <mxCell id="U1_PPOB" value="&lt;b&gt;Layar Checkout Cepat Produk PPOB (FR-002)&lt;/b&gt;&lt;br&gt;Input No. HP / Meteran PLN / PDAM &amp; Nominal&lt;br&gt;(Pulsa, Data, Token Listrik, PDAM — Lewati&lt;br&gt;Keranjang, Biaya Admin Flat Tanpa Komisi)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="694" y="917" width="345" height="94" as="geometry" /></mxCell>
        <mxCell id="U1_CHECKOUT" value="&lt;b&gt;Layar Checkout Fisik &amp; Alamat (FR-012, FR-024)&lt;/b&gt;&lt;br&gt;Pilih Alamat Sarbagita (INV-03) &amp; Kurir Toko;&lt;br&gt;Hitung Ongkir Aktual vs Volumetrik (PxLxT/6000),&lt;br&gt;Asuransi (&gt;=Rp500rb Wajib) &amp; Biaya Layanan Flat" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1274" y="915" width="345" height="98" as="geometry" /></mxCell>
        <mxCell id="U1_DEC_CHK" value="&lt;b&gt;Validasi Checkout Lolos?&lt;/b&gt;&lt;br&gt;1 Toko, Bukan Toko Sendiri,&lt;br&gt;Sarbagita, Stok &amp; Toko Buka" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;strokeWidth=1.6;fontSize=10.5;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1888" y="900" width="276" height="128" as="geometry" /></mxCell>
        <mxCell id="U1_END_FAIL" value="&lt;b&gt;Pesanan Batal &amp; Auto-Refund (FR-002, FR-021)&lt;/b&gt;&lt;br&gt;Rilis Kunci Stok &amp; Kembalikan Potongan Saldo;&lt;br&gt;Gagal Biller PPOB -&gt; 100% Saldo Bebas Tarik" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#7F1D1D;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="114" y="1210" width="344" height="88" as="geometry" /></mxCell>
        <mxCell id="U1_DEC_PAY" value="&lt;b&gt;Status Bayar &amp; Biller?&lt;/b&gt;&lt;br&gt;Lunas / Kedaluwarsa /&lt;br&gt;Hasil Biller PPOB" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;strokeWidth=1.6;fontSize=10.5;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="728" y="1190" width="276" height="128" as="geometry" /></mxCell>
        <mxCell id="U1_PAY" value="&lt;b&gt;Kunci Stok Atomik, Snapshot &amp; Bayar (FR-008)&lt;/b&gt;&lt;br&gt;Reserve Stok Atomik + Snapshot Harga/Diskon/Komisi;&lt;br&gt;Bayar via PG (VA 24j / QRIS-EW 15m) atau Saldo&lt;br&gt;Saya (Potong Saldo Reguler Dulu + PIN 6 Digit)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#047857;fontColor=#064E3B;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1274" y="1205" width="345" height="98" as="geometry" /></mxCell>
        <mxCell id="U1_EXT_TX" value="&lt;b&gt;Touchpoint Gateway (Logistik, PG &amp; Biller) + Handoff&lt;/b&gt;&lt;br&gt;API Logistik (Ongkir/Asuransi) | Payment Gateway&lt;br&gt;API Biller PPOB -&gt; Lunas: Lanjut Hal. 02 (Pesanan&lt;br&gt;Saya / Token PPOB) &amp; Hal. 03 (Notifikasi Penjual)" style="rounded=1;arcSize=12;dashed=1;dashPattern=6 3;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0F766E;fontColor=#134E4A;strokeWidth=1.5;fontSize=10.5;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1854" y="1206" width="345" height="96" as="geometry" /></mxCell>
        <mxCell id="e_1_U1_START_U1_HOME" value="Buka Aplikasi&lt;br&gt;MyPeken" style="edgeStyle=none;rounded=1;arcSize=8;jumpStyle=arc;jumpSize=7;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=classic;endFill=1;startArrow=none;strokeColor=#1D4ED8;strokeWidth=1.35;fontSize=9.5;fontFamily=Helvetica;fontColor=#1D4ED8;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="U1_START" target="U1_HOME"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_2_U1_HOME_U1_SEARCH" value="Cari Kata Kunci /&lt;br&gt;Filter &amp; LBS" style="edgeStyle=none;rounded=1;arcSize=8;jumpStyle=arc;jumpSize=7;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=classic;endFill=1;startArrow=none;strokeColor=#1D4ED8;strokeWidth=1.35;fontSize=9.5;fontFamily=Helvetica;fontColor=#1D4ED8;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="U1_HOME" target="U1_SEARCH"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_3_U1_SEARCH_U1_EXT_DISC" value="Kueri Radius GPS &amp;&lt;br&gt;Geofencing Sarbagita" style="edgeStyle=none;rounded=1;arcSize=8;jumpStyle=arc;jumpSize=7;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=classic;endFill=1;startArrow=none;strokeColor=#0F766E;strokeWidth=1.35;fontSize=9.5;fontFamily=Helvetica;fontColor=#0F766E;labelBackgroundColor=#ffffff;dashed=1;dashPattern=5 3;" edge="1" parent="1" source="U1_SEARCH" target="U1_EXT_DISC"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_4_U1_HOME_U1_PDP_STORE" value="Klik Produk / Banner /&lt;br&gt;Etalase Toko" style="edgeStyle=none;rounded=1;arcSize=8;jumpStyle=arc;jumpSize=7;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.4986;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=classic;endFill=1;startArrow=none;strokeColor=#1D4ED8;strokeWidth=1.35;fontSize=9.5;fontFamily=Helvetica;fontColor=#1D4ED8;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="U1_HOME" target="U1_PDP_STORE"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_5_U1_SEARCH_U1_PDP_STORE" value="Pilih Produk /&lt;br&gt;Toko UMKM" style="edgeStyle=none;rounded=1;arcSize=8;jumpStyle=arc;jumpSize=7;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.3061;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=classic;endFill=1;startArrow=none;strokeColor=#1D4ED8;strokeWidth=1.35;fontSize=9.5;fontFamily=Helvetica;fontColor=#1D4ED8;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="U1_SEARCH" target="U1_PDP_STORE"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1446" y="267.5" /><mxPoint x="1057" y="267.5" /><mxPoint x="1057" y="365" /></Array></mxGeometry></mxCell>
        <mxCell id="e_6_U1_PDP_STORE_U1_AI_CHAT" value="Klik Floating Chat&lt;br&gt;Bantuan AI (FR-003)" style="edgeStyle=none;rounded=1;arcSize=8;jumpStyle=arc;jumpSize=7;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=classic;endFill=1;startArrow=none;strokeColor=#1D4ED8;strokeWidth=1.35;fontSize=9.5;fontFamily=Helvetica;fontColor=#1D4ED8;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="U1_PDP_STORE" target="U1_AI_CHAT"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_7_U1_AI_CHAT_U1_DEC_AI" value="Proses Prompt FAQ /&lt;br&gt;Nomor Pesanan" style="edgeStyle=none;rounded=1;arcSize=8;jumpStyle=arc;jumpSize=7;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.4985;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=classic;endFill=1;startArrow=none;strokeColor=#D97706;strokeWidth=1.35;fontSize=9.5;fontFamily=Helvetica;fontColor=#D97706;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="U1_AI_CHAT" target="U1_DEC_AI"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_8_U1_DEC_AI_U1_AI_CHAT" value="[Terjawab]&lt;br&gt;Tampilkan Solusi" style="edgeStyle=none;rounded=1;arcSize=8;jumpStyle=arc;jumpSize=7;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=classic;endFill=1;startArrow=none;strokeColor=#047857;strokeWidth=1.35;fontSize=9.5;fontFamily=Helvetica;fontColor=#047857;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="U1_DEC_AI" target="U1_AI_CHAT"><mxGeometry x="0.0686" relative="1" as="geometry"><Array as="points"><mxPoint x="106" y="674" /><mxPoint x="106" y="384" /></Array></mxGeometry></mxCell>
        <mxCell id="e_9_U1_DEC_AI_U1_XREF_CS" value="[Di Luar Cakupan]&lt;br&gt;Hubungkan ke Admin CS" style="edgeStyle=none;rounded=1;arcSize=8;jumpStyle=arc;jumpSize=7;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=classic;endFill=1;startArrow=none;strokeColor=#4B5563;strokeWidth=1.35;fontSize=9.5;fontFamily=Helvetica;fontColor=#4B5563;labelBackgroundColor=#ffffff;dashed=1;dashPattern=5 3;" edge="1" parent="1" source="U1_DEC_AI" target="U1_XREF_CS"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_10_U1_PDP_STORE_U1_DEC_AUTH" value="Klik Beli / Keranjang /&lt;br&gt;Chat / Wishlist / Lapor" style="edgeStyle=none;rounded=1;arcSize=8;jumpStyle=arc;jumpSize=7;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.6939;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=classic;endFill=1;startArrow=none;strokeColor=#D97706;strokeWidth=1.35;fontSize=9.5;fontFamily=Helvetica;fontColor=#D97706;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="U1_PDP_STORE" target="U1_DEC_AUTH"><mxGeometry x="-0.3994" relative="1" as="geometry"><Array as="points"><mxPoint x="1178.5" y="403" /><mxPoint x="1178.5" y="384" /></Array></mxGeometry></mxCell>
        <mxCell id="e_11_U1_DEC_AUTH_U1_LOGIN" value="[Guest Mode]&lt;br&gt;Wajib Login (FR-001)" style="edgeStyle=none;rounded=1;arcSize=8;jumpStyle=arc;jumpSize=7;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=classic;endFill=1;startArrow=none;strokeColor=#B91C1C;strokeWidth=1.35;fontSize=9.5;fontFamily=Helvetica;fontColor=#B91C1C;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="U1_DEC_AUTH" target="U1_LOGIN"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_12_U1_LOGIN_U1_ACT_OTP" value="Input Kredensial /&lt;br&gt;Google OAuth" style="edgeStyle=none;rounded=1;arcSize=8;jumpStyle=arc;jumpSize=7;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=classic;endFill=1;startArrow=none;strokeColor=#1D4ED8;strokeWidth=1.35;fontSize=9.5;fontFamily=Helvetica;fontColor=#1D4ED8;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="U1_LOGIN" target="U1_ACT_OTP"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e_13_U1_ACT_OTP_U1_EXT_DISC" value="Kirim 6 Digit OTP&lt;br&gt;WA / SMS / Email" style="edgeStyle=none;rounded=1;arcSize=8;jumpStyle=arc;jumpSize=7;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=classic;endFill=1;startArrow=none;strokeColor=#0F766E;strokeWidth=1.35;fontSize=9.5;fontFamily=Helvetica;fontColor=#0F766E;labelBackgroundColor=#ffffff;dashed=1;dashPattern=5 3;" edge="1" parent="1" source="U1_ACT_OTP" target="U1_EXT_DISC"><mxGeometry x="-0.2257" relative="1" as="geometry"><Array as="points"><mxPoint x="2214" y="674" /><mxPoint x="2214" y="104" /></Array></mxGeometry></mxCell>
