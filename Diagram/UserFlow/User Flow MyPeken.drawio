  <diagram id="uf_02_buyer_post_order_wallet" name="02. Pembeli — Pasca-Transaksi, Komplain, Saldo &amp; Profil">
    <mxGraphModel dx="2280" dy="1380" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2280" pageHeight="1380" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="U2_START" value="&lt;b&gt;Masuk Menu Pembeli Terdaftar&lt;/b&gt;&lt;br&gt;Dari Checkout Lunas (Hal. 01)&lt;br&gt;atau Menu Pesanan, Saldo &amp; Profil" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#7F1D1D;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="148" y="67" width="315" height="76" as="geometry" /></mxCell>
        <mxCell id="U2_ORDERS" value="&lt;b&gt;Layar Daftar &amp; Riwayat Pesanan Saya (FR-032)&lt;/b&gt;&lt;br&gt;7 Tab Status: Menunggu Bayar, Dibayar, Diproses&lt;br&gt;(Menunggu Batal / Mencari Driver), Dikirim (Terkirim),&lt;br&gt;Selesai (Partial Refund), Komplain &amp; Batal" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="705" y="57" width="360" height="96" as="geometry" /></mxCell>
        <mxCell id="U2_DETAIL" value="&lt;b&gt;Layar Detail Pesanan, Lacak &amp; Invoice (FR-030..038)&lt;/b&gt;&lt;br&gt;Timeline Resi / Driver Instan, Nomor Token PPOB,&lt;br&gt;Notifikasi In-App &amp; WA (FR-022), Chat Penjual&lt;br&gt;(FR-036) &amp; Unduh / Cetak Invoice Resmi PDF" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="56" width="345" height="98" as="geometry" /></mxCell>
        <mxCell id="U2_EXT_GW" value="&lt;b&gt;Touchpoint API Logistik &amp; Notifikasi WA/In-App&lt;/b&gt;&lt;br&gt;API Logistik (Webhook Status Pengiriman: Dalam&lt;br&gt;Perjalanan, Terkirim, Gagal Kirim / Dikembalikan)&lt;br&gt;Gateway Notifikasi WA Prioritas &amp; Push In-App" style="rounded=1;arcSize=12;dashed=1;dashPattern=6 3;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0F766E;fontColor=#134E4A;strokeWidth=1.5;fontSize=10.5;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1873" y="58" width="345" height="94" as="geometry" /></mxCell>
        <mxCell id="U2_EXT_PG_OTP" value="&lt;b&gt;Touchpoint Payment Gateway &amp; Gateway OTP&lt;/b&gt;&lt;br&gt;Payment Gateway (Bank Account Inquiry Real-Time&lt;br&gt;&amp; Disbursement Penarikan Saldo Saya)&lt;br&gt;Gateway OTP &amp; Notifikasi (WA / SMS / Email)" style="rounded=1;arcSize=12;dashed=1;dashPattern=6 3;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0F766E;fontColor=#134E4A;strokeWidth=1.5;fontSize=10.5;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="135" y="338" width="340" height="94" as="geometry" /></mxCell>
        <mxCell id="U2_DEC_CANCEL" value="&lt;b&gt;Ajukan Pembatalan?&lt;/b&gt;&lt;br&gt;Sepihak (Menunggu/Dibayar)&lt;br&gt;atau 1x saat Diproses (FR-021)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;strokeWidth=1.6;fontSize=10.5;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="745" y="321" width="280" height="128" as="geometry" /></mxCell>
        <mxCell id="U2_DEC_RECV" value="&lt;b&gt;Konfirmasi / Komplain?&lt;/b&gt;&lt;br&gt;Klik Diterima, Auto 2x24 Jam&lt;br&gt;Terkirim, atau Komplain (FR-020)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;strokeWidth=1.6;fontSize=10.5;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1315" y="321" width="300" height="128" as="geometry" /></mxCell>
        <mxCell id="U2_COMPLAINT" value="&lt;b&gt;Layar Pengajuan Komplain Pesanan (FR-020)&lt;/b&gt;&lt;br&gt;(1) Barang Rusak/Salah/Kurang (Aktif sejak Dikirim;&lt;br&gt;Wajib Foto/Video Unboxing) atau (2) Belum Tiba&lt;br&gt;(&gt;ETD); Pilih Solusi: Full / Partial Refund per Item" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1871" y="336" width="348" height="98" as="geometry" /></mxCell>
        <mxCell id="U2_ACT_WD" value="&lt;b&gt;Penarikan Saldo Saya Otomatis (FR-025)&lt;/b&gt;&lt;br&gt;Validasi Nama Rekening via Bank Inquiry API,&lt;br&gt;Centang Konfirmasi Nama, Verifikasi PIN 6 Digit&lt;br&gt;+ OTP Multi-Saluran, Lock Pending &amp; Disbursement" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#047857;fontColor=#064E3B;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="135" y="627" width="340" height="96" as="geometry" /></mxCell>
        <mxCell id="U2_ACT_REFUND" value="&lt;b&gt;Proses Pembatalan &amp; Alokasi Refund (FR-009, FR-021)&lt;/b&gt;&lt;br&gt;Kembalikan Stok; Batal Mandiri -&gt; Saldo Reguler&lt;br&gt;(Biaya Layanan Non-Refundable); Tolak/Timeout&lt;br&gt;Penjual, Gagal Driver / Salah Kurir -&gt; Bebas Tarik" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#047857;fontColor=#064E3B;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="713" y="626" width="345" height="98" as="geometry" /></mxCell>
        <mxCell id="U2_DONE" value="&lt;b&gt;Pesanan Selesai &amp; Rilis Escrow (FR-008, FR-009)&lt;/b&gt;&lt;br&gt;Cairkan Dana Bersih ke Saldo Toko (Potong Komisi)&lt;br&gt;atau Bagi Escrow Proporsional pada Partial Refund" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#047857;fontColor=#064E3B;strokeWidth=1.5;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="627" width="345" height="96" as="geometry" /></mxCell>
        <mxCell id="U2_DEC_MED" value="&lt;b&gt;Hasil Mediasi 1x24 Jam?&lt;/b&gt;&lt;br&gt;Penjual Setuju vs Tolak/&lt;br&gt;Timeout / Gagal Kirim" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;strokeWidth=1.6;fontSize=10.5;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1907" y="611" width="276" height="128" as="geometry" /></mxCell>
        <mxCell id="U2_PROFILE" value="&lt;b&gt;Layar Profil, Keamanan &amp; Alamat (FR-024..039)&lt;/b&gt;&lt;br&gt;CRUD Alamat Sarbagita (INV-03), Wishlist/Follow,&lt;br&gt;Atur/Reset PIN Saldo 6 Digit (5x Salah Blokir 15m),&lt;br&gt;Ubah No. HP (OTP Lama -&gt; Baru) &amp; Buka Toko" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="135" y="916" width="340" height="98" as="geometry" /></mxCell>
        <mxCell id="U2_WALLET" value="&lt;b&gt;Layar Saldo Saya — 2 Sub-Bucket (FR-025, INV-06)&lt;/b&gt;&lt;br&gt;(1) Saldo Bebas Biaya Tarik (Min. Rp0, Biaya Rp0)&lt;br&gt;(2) Saldo Reguler (Min. Tarik &amp; Biaya Transfer);&lt;br&gt;Belanja Kembali Potong Saldo Reguler Dulu" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="713" y="917" width="345" height="96" as="geometry" /></mxCell>
        <mxCell id="U2_REVIEW" value="&lt;b&gt;Layar Rating &amp; Ulasan Produk (FR-013, FR-040)&lt;/b&gt;&lt;br&gt;Bintang 1–5, Ulasan &amp; Maks. 3 Foto (Hanya Status&lt;br&gt;&quot;Selesai&quot; / Partial Refund, Maks. 30 Hari, 1x Tanpa&lt;br&gt;Edit); Tombol Laporkan Ulasan Spam ke Admin" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1293" y="917" width="345" height="96" as="geometry" /></mxCell>
        <mxCell id="U2_RETUR" value="&lt;b&gt;Layar Arbitrase Admin &amp; Resi Retur (FR-010)&lt;/b&gt;&lt;br&gt;Putusan Retur: Input Resi &amp; Struk Ongkir Retur&lt;br&gt;Maks. 3x24 Jam (Lewat 3x24j -&gt; Gugur ke Penjual);&lt;br&gt;Ongkir Retur Diganti jika Kesalahan Penjual" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontColor=#1E3A8A;strokeWidth=1.6;fontSize=11;fontFamily=Helvetica;spacing=4;" vertex="1" parent="1"><mxGeometry x="1873" y="916" width="345" height="98" as="geometry" /></mxCell>
