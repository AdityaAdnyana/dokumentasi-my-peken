        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    %% Aktor Utama (Kiri)\n    Pembeli[\&quot;Aktor: Pembeli (Buyer)\&quot;]\n    Penjual[\&quot;Aktor: Penjual UMKM (Seller)\&quot;]\n\n    %% Batas Sistem Tunggal (Tengah)\n    subgraph Sistem[\&quot;Sistem Marketplace UMKM MyPeken\&quot;]\n        direction TB\n\n        %% Use Case Autentikasi &amp; Pengaturan Akun\n        UC01([\&quot;Login Google OAuth &amp; Beralih Mode\&quot;])\n        UC01_OTP([\&quot;Verifikasi 6 Digit OTP WhatsApp\&quot;])\n        UC24([\&quot;Kelola Profil &amp; Buku Alamat Pengiriman\&quot;])\n        UC04([\&quot;Ajukan Pembukaan Toko\&quot;])\n        UC04_KYC([\&quot;Upload KYC &amp; Validasi GPS Sarbagita\&quot;])\n\n        %% Use Case Eksplorasi &amp; Transaksi Pembeli\n        UC11([\&quot;Cari Produk/Toko Terdekat (LBS GPS)\&quot;])\n        UC26([\&quot;Cari &amp; Filter Produk (Kategori/Harga)\&quot;])\n        UC23([\&quot;Kelola Keranjang (Single-Seller Checkout)\&quot;])\n        UC12([\&quot;Pilih Kurir &amp; Hitung Ongkir Otomatis\&quot;])\n        UC08([\&quot;Bayar Pesanan via Payment Gateway (Escrow)\&quot;])\n        UC03([\&quot;Tanya Bantuan AI &amp; Lacak Pesanan\&quot;])\n\n        %% Use Case Pesanan, Komplain, Retur &amp; Ulasan\n        UC14([\&quot;Proses Pesanan &amp; Input Resi / Pickup Kurir\&quot;])\n        UC21([\&quot;Batalkan atau Tolak Pesanan\&quot;])\n        UC21_Ref([\&quot;Proses Refund Dana Otomatis\&quot;])\n        UC20([\&quot;Konfirmasi Pesanan Diterima\&quot;])\n        UC13([\&quot;Beri Rating &amp; Ulasan Produk\&quot;])\n        UC20_Komp([\&quot;Ajukan Komplain &amp; Bukti Unboxing\&quot;])\n        UC10_Retur([\&quot;Input Resi Retur &amp; Konfirmasi Terima Retur\&quot;])\n\n        %% Use Case Manajemen Toko &amp; Penarikan Dana\n        UC05([\&quot;Kelola Etalase Produk &amp; Varian (CRUD)\&quot;])\n        UC15([\&quot;Tarik Saldo Pendapatan Toko (Withdrawal)\&quot;])\n        UC25([\&quot;Tarik Saldo Refund Pembeli\&quot;])\n\n        %% Use Case Khusus Admin\n        UC03_Chat([\&quot;Tangani Eskalasi Live Chat\&quot;])\n        UC27([\&quot;Verifikasi &amp; Setujui/Tolak Toko Baru\&quot;])\n        UC09([\&quot;Atur Skema Biaya Layanan Platform\&quot;])\n        UC10([\&quot;Mediasi &amp; Putuskan Resolusi Konflik\&quot;])\n        UC18([\&quot;Moderasi Master Data (Suspend &amp; Hapus Produk)\&quot;])\n    end\n\n    %% Aktor Sekunder / Admin (Kanan)\n    Admin[\&quot;Aktor: Admin Sistem\&quot;]\n\n    %% Asosiasi Pembeli (Kiri ke Tengah)\n    Pembeli --- UC01\n    Pembeli --- UC24\n    Pembeli --- UC04\n    Pembeli --- UC11\n    Pembeli --- UC26\n    Pembeli --- UC23\n    Pembeli --- UC21\n    Pembeli --- UC20\n    Pembeli --- UC25\n    Pembeli --- UC03\n\n    %% Asosiasi Penjual (Kiri ke Tengah)\n    Penjual --- UC01\n    Penjual --- UC05\n    Penjual --- UC14\n    Penjual --- UC21\n    Penjual --- UC10_Retur\n    Penjual --- UC15\n\n    %% Asosiasi Admin (Tengah ke Kanan)\n    UC03_Chat --- Admin\n    UC27 --- Admin\n    UC09 --- Admin\n    UC10 --- Admin\n    UC18 --- Admin\n\n    %% Relasi &lt;&lt;include&gt;&gt; (Kewajiban Sistem)\n    UC01 -.-&gt;|\&quot;&lt;&lt;include&gt;&gt;\&quot;| UC01_OTP\n    UC04 -.-&gt;|\&quot;&lt;&lt;include&gt;&gt;\&quot;| UC04_KYC\n    UC23 -.-&gt;|\&quot;&lt;&lt;include&gt;&gt;\&quot;| UC12\n    UC23 -.-&gt;|\&quot;&lt;&lt;include&gt;&gt;\&quot;| UC08\n    UC21 -.-&gt;|\&quot;&lt;&lt;include&gt;&gt;\&quot;| UC21_Ref\n\n    %% Relasi &lt;&lt;extend&gt;&gt; (Kondisional / Opsional)\n    UC13 -.-&gt;|\&quot;&lt;&lt;extend&gt;&gt;\&quot;| UC20\n    UC20_Komp -.-&gt;|\&quot;&lt;&lt;extend&gt;&gt;\&quot;| UC20\n    UC10 -.-&gt;|\&quot;&lt;&lt;extend&gt;&gt;\&quot;| UC20_Komp\n    UC10_Retur -.-&gt;|\&quot;&lt;&lt;extend&gt;&gt;\&quot;| UC10\n    UC03_Chat -.-&gt;|\&quot;&lt;&lt;extend&gt;&gt;\&quot;| UC03&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="K32lF-7Nbcqi1ch44CV2-150">
